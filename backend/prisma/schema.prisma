datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ContentType {
  HERO
  PROJECT
  HOBBY
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions    Session[]
  resetTokens PasswordResetToken[]
}

// The session id itself IS the opaque bearer token returned to the client.
model Session {
  id        String   @id
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    // sha256 of the raw token that was emailed; raw token is never stored
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// One row per editable content item. Admin writes only ever touch draftJson;
// the public API only ever reads publishedJson. Publishing copies draft -> published
// in a single transaction, so an unpublished edit can never leak to the public site.
model ContentEntry {
  id             String      @id @default(cuid())
  type           ContentType
  slug           String      // "hero" | goodflip/marketing-skill/playlist-sync/quicko/streak/tools | art/cooking/playlists
  draftJson      Json
  publishedJson  Json?
  draftUpdatedAt DateTime    @updatedAt
  publishedAt    DateTime?
  createdAt      DateTime    @default(now())

  @@unique([type, slug])
}

// Append-only snapshot on every publish, for cheap manual rollback if the
// client publishes something wrong. Not a full revision history UI in v1.
model PublishLog {
  id          String      @id @default(cuid())
  contentType ContentType
  slug        String
  snapshot    Json
  publishedAt DateTime    @default(now())

  @@index([contentType, slug])
}

model Media {
  id          String   @id @default(cuid())
  key         String   @unique // R2 object key, e.g. "uploads/2026/08/abc123.jpg"
  publicUrl   String
  altText     String?
  width       Int?
  height      Int?
  contentType String?
  sizeBytes   Int?
  createdAt   DateTime @default(now())
}
