# Postgres connection string (Render Postgres gives you this directly)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# One-time bootstrap admin account, consumed once by `npm run seed`.
# Tell the client to log in with these once, then immediately use
# "Change password" in the admin so nobody depends on this value again.
ADMIN_SEED_EMAIL="you@example.com"
ADMIN_SEED_PASSWORD="change-me-immediately"

# CORS allow-list for the /api/admin/* routes (comma-separated, no spaces).
# Must be the exact origin(s) the admin portal is served from.
ADMIN_ALLOWED_ORIGINS="https://your-admin-site.netlify.app,http://localhost:8888"

# Resend (resend.com) — used for password-reset emails. Free tier is enough.
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Public URL of the ADMIN site (used to build the password-reset link sent by email)
ADMIN_PUBLIC_URL="https://your-admin-site.netlify.app"

# Cloudflare R2 (S3-compatible). Create a bucket + API token in the Cloudflare dashboard.
R2_ACCOUNT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_ACCESS_KEY_ID="xxx"
R2_SECRET_ACCESS_KEY="xxx"
R2_BUCKET="portfolio-media"
# Public base URL the bucket is served from — either R2's own public dev URL,
# or a custom domain you've connected to the bucket.
R2_PUBLIC_BASE_URL="https://media.yourdomain.com"

# Port Render will inject its own PORT — this is only used for local dev.
PORT=4000
